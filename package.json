{
  "name": "magic",
  "version": "0.1.0",
  "description": "Alpha. MAGIC mixes Lua and BASIC and compiles to JavaScript.",
  "author": {
    "name": "Mira (The White Witch™)",
    "email": "thewhitewitchtm@google.com",
    "url": "https://x.com/TheWhiteWitchTM"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "magic": "./dist/cli.js",
    "msx": "./dist/tools/msx.js",
    "js2magic": "./dist/tools/js2magic.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/modules/canvas.d.ts",
      "import": "./dist/modules/canvas.js"
    },
    "./terminal": {
      "types": "./dist/modules/terminal.d.ts",
      "import": "./dist/modules/terminal.js"
    },
    "./sound": {
      "types": "./dist/modules/sound.d.ts",
      "import": "./dist/modules/sound.js"
    },
    "./hex": {
      "types": "./dist/modules/hex.d.ts",
      "import": "./dist/modules/hex.js"
    },
    "./games": {
      "types": "./dist/modules/games.d.ts",
      "import": "./dist/modules/games.js"
    }
  },
  "files": [
    "dist",
    "browser",
    "src",
    "examples",
    "lang",
    "editors",
    "site",
    "ARCHITECTURE.md",
    "CHANGES.md",
    "INTERFACES.md",
    "LANGUAGE.md",
    "LEARN.md",
    "MODULES.md",
    "README.md",
    "LICENSE",
    "tools"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "prepare": "npm run build",
    "demo": "npm run build && node examples/demo.js",
    "serve": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "magic": "node dist/cli.js",
    "msx": "node dist/tools/msx.js",
    "js2magic": "node dist/tools/js2magic.js"
  },
  "dependencies": {
    "emoji-engine-2d": "file:../emoji-engine-2d",
    "emoji-engine-3d": "file:../emoji-engine-3d",
    "emoji-engine-ui": "file:../emoji-engine-ui",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
